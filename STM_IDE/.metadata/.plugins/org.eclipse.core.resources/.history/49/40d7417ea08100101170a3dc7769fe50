/* USER CODE BEGIN 4 */
void HCMS2903_Init(void)
{
  // Reset display (active low, hold for 1 ms)
  HAL_GPIO_WritePin(DISPLAY_RESET_GPIO_Port, DISPLAY_RESET_Pin, GPIO_PIN_RESET);
  HAL_Delay(1);
  HAL_GPIO_WritePin(DISPLAY_RESET_GPIO_Port, DISPLAY_RESET_Pin, GPIO_PIN_SET);
  HAL_Delay(1);

  // Load Control Word 0: Wake up, max brightness (D7=0, D6=0, D5-D3=000, D2-D0=111)
  HAL_GPIO_WritePin(DISPLAY_RS_GPIO_Port, DISPLAY_RS_Pin, GPIO_PIN_SET);   // RS high for Control Register
  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_RESET); // CE low to start
  HCMS2903_WriteControl(0x7F); // 00000111: Normal mode, max PWM brightness
  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_SET);   // CE high to latch
  HAL_Delay(1); // Ensure data is copied when CLK goes low

  // Load Control Word 1: Serial mode, no prescaler (D7=1, D1=0, D0=0)
  HAL_GPIO_WritePin(DISPLAY_RS_GPIO_Port, DISPLAY_RS_Pin, GPIO_PIN_SET);   // RS high
  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_RESET); // CE low
  HCMS2903_WriteControl(0x80); // 10000000: Serial mode, no prescaler
  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_SET);   // CE high to latch
  HAL_Delay(1);
}

void HCMS2903_WriteControl(uint8_t controlWord)
{
  // Shift in 8 bits, MSB first, on rising CLK edges
  HAL_SPI_Transmit(&hspi3, &controlWord, 1, HAL_MAX_DELAY); // Changed from hspi1 to hspi3k
  // Data is copied to Control Register when CLK goes low (handled by SPI hardware)
}

void HCMS2903_WriteChar(uint8_t character, uint8_t position)
{
  if (character < 32 || character > 127) return; // Validate ASCII
  uint8_t index = character - 32;

  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_SET); // CE high to start
  HAL_GPIO_WritePin(DISPLAY_RS_GPIO_Port, DISPLAY_RS_Pin, GPIO_PIN_RESET); // RS low for Dot Register
  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_RESET); // CE low to start

  // Send 5 bytes for the character (5 columns of 7 bits)
  for (uint8_t i = 0; i < 5; i++)
  {
    HAL_SPI_Transmit(&hspi3, &font_5x7[index][i], 1, HAL_MAX_DELAY); // Changed from hspi1 to hspi3
  }

  HAL_GPIO_WritePin(DISPLAY_CE_GPIO_Port, DISPLAY_CE_Pin, GPIO_PIN_SET); // CE high to latch
}

void HCMS2903_DisplayString(const char* str)
{
  for (uint8_t pos = 0; pos < 4 && str[pos] != '\0'; pos++)
  {
    HCMS2903_WriteChar(str[pos], pos);
  }
}

